# Milliy Narx - Environment Variables
# Server: Contabo VPS & Local Development

# Database (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://milliynarx_user:YOUR_PASSWORD@localhost:5432/milliynarx
# For local dev without postgres:
# DATABASE_URL=sqlite:///./milliy_narx.db

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Intelligence — OpenRouter DeepSeek Models (Backend only)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat:free,deepseek/deepseek-r1:free
OPENAI_API_KEY=

# File Storage
UPLOAD_DIR=/var/www/milliynarx/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=["https://milliynarx.eduxa.uz","http://milliynarx.eduxa.uz","https://milliynarx.uz","http://milliynarx.uz","https://milliynarx.vercel.app","http://milliynarx.vercel.app","https://milliynarx-uz-topaz.vercel.app","https://milliy-narx.uz","http://milliy-narx.uz","http://localhost:5173"]

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=milliynarxbot

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend Build (Vite)
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
