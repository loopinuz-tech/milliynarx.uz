# Milliy Narx - Environment Variables

# Database (PostgreSQL)
DATABASE_URL=postgresql://milliynarx_user:YOUR_PASSWORD@localhost:5432/milliynarx

# JWT Authentication
JWT_SECRET=your-jwt-secret-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Intelligence — OpenRouter DeepSeek Models (Backend only)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat:free,deepseek/deepseek-r1:free
OPENAI_API_KEY=

# File Storage
UPLOAD_DIR=/var/www/milliynarx/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=["https://milliynarx.eduxa.uz","http://milliynarx.eduxa.uz","http://localhost:5173"]
