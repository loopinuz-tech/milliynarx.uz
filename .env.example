# Milliy Narx - Production Environment Variables
# Server: Contabo VPS

# Database (PostgreSQL hosted on Contabo VPS)
DATABASE_URL=postgresql://milliynarx_user:SecureContaboPass2026!@localhost:5432/milliynarx
# For local dev fallback without postgres:
# DATABASE_URL=sqlite:///./milliy_narx.db

# JWT Authentication
JWT_SECRET=super-secret-milliy-narx-terminal-jwt-key-2026-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Intelligence — OpenRouter DeepSeek Models (Backend only)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731:free
OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-chat:free,deepseek/deepseek-r1:free
OPENAI_API_KEY=

# File Storage
UPLOAD_DIR=/var/www/milliynarx/uploads
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=["https://milliynarx.uz","http://milliynarx.uz","https://milliynarx.vercel.app","http://milliynarx.vercel.app","https://milliynarx-uz-topaz.vercel.app","https://milliy-narx.uz","http://milliy-narx.uz","http://localhost:5173"]

# Frontend Build (Vite)
VITE_API_URL=/api
